// Hooks to different consequences (events, but other things as well)
// that can happen/run as a result of actions.
// Idea is to store these in rewind buffer so they can be rewound.
#define jumpToHack_r4(offset) "BYTE 0x00 0x4C 0x20 0x47; POIN (offset|0x1)"

PUSH

  // Unit loading.
    ORG 0xF770
      jumpToHack(REW_hookLoadUnit)
    ORG 0xFF42
      SHORT 0x0       // NOP
      jumpToHack(REW_hookEnun)
      SHORT 0x0       // NOP
  
  // Unit movement.
    
    // Playerphase move unit.
    ORG 0x1D470     // PlayerPhase_ApplyUnitMovement
      jumpToHack(REW_hookPlayerPhaseUnitMove)
    
    // Playerphase cancel unitmovement.
    ORG 0x1D008     // PlayerPhase_BackToMove
      jumpToHack(REW_hookPlayerPhaseCancelUnitMove)
    
    // Other phases move unit.
    ORG 0x39C24     // AiSetDecision.
      jumpToHack_r4(REW_hookOtherPhaseUnitMove)
  
  // Track item inventory changes.
  
    // Unit inventory reordering.
    // Whenever a unit equips an item
    // we need to track how the inventory is reordered.
    ORG 0x16BC0
      jumpToHack(REW_hookEquipItem)
    
    // Track whenever a unit obtains an item.
    ORG 0x17948
      jumpToHack(REW_hookItemObtained)
    
    // Track whenever an item is taken from supply by a unit.
    //ORG 0x9E324
      //callHack_r3(REW_hookItemTakenFromSupply)
      //SHORT 0x0       // NOP
    
    // Track whenever an item is given to supply by a unit.
    //ORG 0x9E87C
      //callHack_r3(REW_hookItemGivenToSupply)
      //SHORT 0x0       // NOP

    // Take a snapshot of a unit's inventory before they interact with supply.
    ORG 0x9EB38
      jumpToHack(REW_hookSupplyTakeSnapshot)
    
    // Compare unit's inventory to prior snapshot and track the two inventories.
    ORG 0x9EA7C
      jumpToHack(REW_hookSupplyTrackInventories)
    
  
    // Item obtained through loot-drop, event or chest.
    /*
    ORG 0x2F510   // Track key item used.
      jumpToHack(REW_hookLootChestReceive5)
    ORG 0x1E0A2       // Inventory may or may not be full.
      SHORT 0x0       // NOP
      jumpToHack(REW_hookLootChestReceive1)
    ORG 0x1E188       // Inventory full, send different item to convoy.
      jumpToHack(REW_hookLootChestReceive2)
    ORG 0x1E1DC       // Inventory full, send obtained item to convoy.
      jumpToHack(REW_hookLootChestReceive3)
    ORG 0x1E2B2       // Inventory full, convoy full/unavailable. discard different item.
      SHORT 0x0       // NOP
      jumpToHack(REW_hookLootChestReceive4)
    */
  
    // Item obtained through drop/steal/chest.
  
      // - Inventory not full.
      //   TODO
    
      //  - Inventory full,
      //    supply unavailable/full,
      //    discard one of the not-just-obtained items.
      ORG 0x1E2B4
      //    TODO
      
      //  - Inventory full,
      //    supply unavailable/full,
      //    discard the just obtained item.
      // No need to track anything as neither inventory nor supply changes.
        
      //  - Inventory full,
      //    supply available,
      //    send one of the not-just-obtained items to supply.
      ORG 0x1E188
      //    TODO
      
      //  - Inventory full,
      //    supply available,
      //    send the just obtained item to supply.
      ORG 0x1E1DC
      //    TODO
    
    // Trading with supply.
    
      // - Take from supply.
      ORG 0x9E2C8
      //   TODO
      
      // - Give to supply.
      ORG 0x9E85C
      //   TODO
      
    // Trading with other unit.
      // TODO

POP

ALIGN 4; #include "loadUnit.lyn.event"
ALIGN 4; #include "item.lyn.event"
ALIGN 4; #include "move.lyn.event"